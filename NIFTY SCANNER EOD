.github/workflows/scanner_eod.yml 
name: Nifty scanner - EOD refresh
on:
  push:
    paths: ['nifty_scanner.py', '.github/workflows/scanner_eod.yml']   # runs once automatically when you upload
  schedule:
    - cron: "30 11 * * 1-5"      # 17:00 IST, Mon-Fri (NSE closes 15:30 IST)
    - cron: "30 12 * * 1-5"      # 18:00 IST safety re-run
  workflow_dispatch: {}
permissions:
  contents: write
concurrency: { group: scanner, cancel-in-progress: false }
jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.11" }
      - run: pip install pandas numpy openpyxl requests yfinance
      - name: Run scanner (keeps old data if too few tickers load)
        run: python nifty_scanner.py --out NIFTY_STRUCTURAL_SCANNER.xlsx --publish-dir data
      - name: Publish data for the Google Sheet
        run: |
          git config user.name  "scanner-bot"
          git config user.email "scanner-bot@users.noreply.github.com"
          git add data cache || true
          git diff --cached --quiet || git commit -m "EOD data $(date -u +%F)"
          git pull --rebase origin ${{ github.ref_name }} || true
          git push
